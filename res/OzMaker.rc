#pragma code_page(65001)
#include "resource.h"
#include "../src/Version.h"
#include <winres.h>

IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OZ_VERSION_MAJOR,OZ_VERSION_MINOR,OZ_VERSION_PATCH,0
 PRODUCTVERSION OZ_VERSION_MAJOR,OZ_VERSION_MINOR,OZ_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "FileDescription", "OzMaker - 움짤 메이커"
            VALUE "FileVersion", OZ_VERSION_STR
            VALUE "ProductName", "OzMaker"
            VALUE "ProductVersion", OZ_VERSION_STR
            VALUE "OriginalFilename", "OzMaker.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
